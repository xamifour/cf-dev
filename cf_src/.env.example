# cf-dev/.env.example
# Copy to /etc/cf/config.env and /etc/cf/secrets.env (or load via environ).

DEBUG=True
SECRET_KEY_DEV=change-me-dev-only-not-for-production
SECRET_KEY_LIVE=change-me-production-secret-key-min-50-chars

ALLOWED_HOSTS_DEV=127.0.0.1,localhost
ALLOWED_HOSTS_LIVE=example.com,www.example.com

DEFAULT_DB_NAME=cf
DEFAULT_DB_USER=cf_app
DEFAULT_DB_PASSWORD=change-me
DEFAULT_DB_HOST=127.0.0.1
DEFAULT_DB_PORT=5432
DEFAULT_DB_CONN_MAX_AGE=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional CF users overrides
CF_USERS_USER_PASSWORD_EXPIRATION=90
CF_USERS_STAFF_USER_PASSWORD_EXPIRATION=60
CF_USERS_AUTH_BACKEND_AUTO_PREFIXES=+233,+234

# Birthday auto-messages (Celery beat daily)
